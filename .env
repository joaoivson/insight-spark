# API
# Em localhost, deixe VAZIO/comentado: o api.config cai no proxy do Vite
# (URL relativa), e o proxy do vite.config aponta para o backend em :8000 —
# que é onde o docker-compose sobe a API. Fixar http://localhost:8080 aqui
# fazia toda chamada local bater na porta do próprio dev server: a tela
# carregava do cache do localStorage e PARECIA funcionar, com 404 silencioso
# por trás.
#
# hml e produção NÃO dependem disto: api.config resolve pelo hostname
# (API_BY_HOST) e o CI passa VITE_API_URL como variável de ambiente, que tem
# precedência sobre este arquivo.
# VITE_API_URL=http://localhost:8000
# VITE_API_URL=http://api.hml.marketdash.com.br

# WhatsApp Suporte (número sem + e espaços, ex: 34998557753)
VITE_WHATSAPP_NUMBER=3488100161

# Feedback (email destino e mínimo de navegações para exibir o botão)
VITE_FEEDBACK_EMAIL=relacionamento@marketdash.com.br
VITE_FEEDBACK_MIN_NAVIGATIONS=10

